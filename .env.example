# Скопіюйте цей файл у .env і заповніть. Файл .env НЕ потрапляє в git.

# Telegram-бот (токен від @BotFather)
TELEGRAM_BOT_TOKEN=

# Claude API (console.anthropic.com → API Keys). Без ключа бот працює за анкетою без ШІ.
ANTHROPIC_API_KEY=
# Модель. claude-opus-5-5 — найякісніша; claude-haiku-5-5 — приблизно в 40 разів дешевша.
CLAUDE_MODEL=claude-opus-5-5

# Ключі безпеки: згенеруйте командою  python -m app.cli gen-keys
# ВАЖЛИВО: FERNET_KEY не можна змінювати після запуску — інакше збережені коди не розшифруються.
SECRET_KEY=
FERNET_KEY=

# Веб-платформа
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Адреса, за якою платформа відкривається (використовується в посиланнях бота і листах)
BASE_URL=http://localhost:8000
# true — на сервері з HTTPS
COOKIE_SECURE=false

# Email-сповіщення адвокату (необов'язково). Для Gmail: smtp.gmail.com, порт 587,
# пароль — «пароль застосунку» (Google Акаунт → Безпека → Паролі застосунків).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LAWYER_EMAIL=
